assets/** binary

# Repo-AUTHORED text under a broad `binary` rule needs its own eol rule: `binary` (-diff -merge
# -text) also switches off the line-ending normalization that core.autocrlf=true would otherwise
# apply at commit time, which had been silently masking CRLF written by a script on Windows
# (DECISIONS.md D18 records the episode). assets/PROVENANCE.md is generated by
# scripts/vendor_assets.py; it has no "byte-exact to upstream" contract like the vendored files,
# so pinning it to LF is a safety net, not a corruption risk. Last matching pattern wins per
# attribute, so this overrides `assets/** binary` for this one path.
assets/PROVENANCE.md text eol=lf

# The benchmark docs are appended to by testbed/bench/report.py::append_row (an unattended
# writer, like the ledger script); pin them to LF so a Windows checkout can never leave a
# mixed-EOL tracked file (D18).
docs/benchmarks/*.md text eol=lf
